generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String
  anggotaId Int?     @unique
  anggota   Anggota? @relation(fields: [anggotaId], references: [id])
}

model Wilayah {
  id        Int       @id @default(autoincrement())
  kecamatan String
  desa      String
  dusun     String
  anggota   Anggota[]
  
  @@unique([kecamatan, desa, dusun])
}

model Anggota {
  id            Int      @id @default(autoincrement())
  nik           String   @unique
  nama          String
  tanggalLahir  String?
  jenisKelamin  String?
  umur          Int?
  nomorHp       String?
  bagian        String?
  jabatan       String?
  
  // Relasi ke wilayah
  wilayahId     Int?
  wilayah       Wilayah? @relation(fields: [wilayahId], references: [id])
  
  // Agar kompatibel dengan script lama jika wilayah tidak ter-map ke id
  kecamatan     String?
  desa          String?
  dusun         String?
  rt            String?
  rw            String?

  fotoKtpUrl    String?
  passFotoUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  kehadiran     KehadiranAgenda[]
  user          User?
}

model KasOrganisasi {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  tipe       String
  nominal    Int
  kategori   String?
  keterangan String?
  operator   String?
  createdAt  DateTime @default(now())
}

model LogAktivitas {
  id        Int      @id @default(autoincrement())
  waktu     DateTime @default(now())
  pengguna  String
  aksi      String
  detail    String?
}

model Agenda {
  id          Int      @id @default(autoincrement())
  namaAcara   String
  tempat      String
  waktu       DateTime
  deskripsi   String?  @db.Text
  fotoUrl     String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kehadiran   KehadiranAgenda[]
  lampiran    LampiranAgenda[]
}

model LampiranAgenda {
  id         Int      @id @default(autoincrement())
  agendaId   Int
  agenda     Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  namaFile   String
  fileUrl    String
  tipeFile   String   // "image", "pdf", "document", "spreadsheet", "other"
  ukuran     Int      // ukuran file dalam bytes
  createdAt  DateTime @default(now())
}

model KehadiranAgenda {
  id          Int      @id @default(autoincrement())
  agendaId    Int
  agenda      Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  anggotaId   Int
  anggota     Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([agendaId, anggotaId])
}

model SuratMasuk {
  id            Int      @id @default(autoincrement())
  nomorSurat    String               // Nomor surat dari pengirim
  nomorAgenda   String   @unique     // Nomor agenda internal (auto: 001/IN/PAC/IX/2026)
  tanggalSurat  DateTime             // Tanggal pada surat
  tanggalTerima DateTime             // Tanggal surat diterima
  pengirim      String               // Instansi/Orang pengirim
  perihal       String
  isiRingkas    String?  @db.Text    // Ringkasan isi surat (opsional)
  lampiranUrl   String?              // URL file scan surat (opsional)
  disposisi     String?  @db.Text    // Catatan disposisi
  status        String   @default("BELUM_DIBACA") // BELUM_DIBACA, DIBACA, DIPROSES, SELESAI
  operator      String?              // Siapa yang menginput
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SuratKeluar {
  id            Int      @id @default(autoincrement())
  nomorSurat    String   @unique     // Nomor surat otomatis (auto: 001/EX/PAC/IX/2026)
  tanggalSurat  DateTime             // Tanggal surat
  tujuan        String               // Tujuan surat (ke siapa/instansi)
  perihal       String
  jenisSurat    String               // UNDANGAN, SURAT_TUGAS, SURAT_KETERANGAN, SURAT_EDARAN, SK_PANITIA, LAINNYA
  isiRingkas    String?  @db.Text    // Ringkasan isi surat (opsional)
  status        String   @default("DRAFT") // DRAFT, TERKIRIM, SELESAI
  operator      String?              // Siapa yang membuat
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
